<Window x:Class="PdfReviewApp.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF照査支援アプリ" Height="900" Width="1400">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="PDFを開く" />
            <Separator />
            <ToggleButton Content="同期" IsChecked="{Binding IsSyncEnabled}" />
            <Separator />
            <Button Content="マーカー" />
            <Button Content="赤線" />
            <Button Content="テキスト" />
            <Separator />
            <Button Content="保存" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <TextBlock Text="Left PDF Pane (TODO)" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray" />

            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <TextBlock Text="Right PDF Pane (TODO)" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
